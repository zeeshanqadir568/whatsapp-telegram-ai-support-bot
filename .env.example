# LLM Configuration
# Options: 'anthropic' or 'ollama'
LLM_PROVIDER=anthropic

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama Fallback Configuration (Local / Offline mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# RAG & ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database Configuration
DATABASE_URL=sqlite:///./data/support_bot.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Rate Limiting Caps (Requests Per Day)
RATE_LIMIT_BASIC=50
RATE_LIMIT_PRO=500
RATE_LIMIT_ENTERPRISE=5000

# Telegram Bot Integration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp Business Integration (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
