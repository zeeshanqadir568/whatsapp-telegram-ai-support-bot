# LLM Configuration
# Options: 'anthropic' or 'ollama'
LLM_PROVIDER=anthropic

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama Fallback Configuration (Local / Offline mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# RAG & ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database Configuration
DATABASE_URL=sqlite:///./data/support_bot.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Public-deployment guards
# ADMIN_TOKEN unlocks /api/leads and /api/upload (send it as the X-Admin-Token header).
# Leave it empty to keep both endpoints disabled, which is right for a public demo.
ADMIN_TOKEN=
# /chat limits: messages per minute per visitor IP, and total messages per day
CHAT_RATE_PER_MINUTE=10
CHAT_DAILY_CAP=500
# Number of reverse proxies in front of the app (1 on Hugging Face Spaces / Render)
TRUSTED_PROXY_HOPS=1

# Telegram Bot Integration
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Any random string; pass the same value as secret_token when calling setWebhook
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# WhatsApp Business Integration (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
# Meta "App secret" - used to verify the X-Hub-Signature-256 on every webhook
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Demo Knowledge Base Seeding
# true  = seed the built-in sample FAQ when the vector store is empty
# false = never seed; use this when loading a real client's content
SEED_DEMO_KB=true
